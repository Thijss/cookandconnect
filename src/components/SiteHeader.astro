---
import type { SanityPageLink } from '../lib/sanity';

interface Props {
  currentPage: string;
  navigationPages: SanityPageLink[];
}

const { currentPage, navigationPages } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = navigationPages.map((page) => ({
  ...page,
  path: page.slug === 'home' ? '' : `${page.slug}/`,
  label: page.menuLabel?.trim() || (page.slug === 'home' ? 'Home' : page.title),
}));
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Cook & Connect home">
    <img src={`${base}assets/logo.jpeg`} alt="" />
  </a>
  <details class="mobile-menu">
    <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
    <nav class="site-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a href={`${base}${item.path}`} aria-current={currentPage === item.slug ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </details>
  <nav class="site-nav desktop-nav" aria-label="Main navigation">
    {navigation.map((item) => (
      <a href={`${base}${item.path}`} aria-current={currentPage === item.slug ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>
