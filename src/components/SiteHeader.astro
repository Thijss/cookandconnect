---
interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = [
  { slug: 'home', path: '', label: 'Home' },
  { slug: 'become-a-host', path: 'become-a-host/', label: 'Become a host' },
  { slug: 'join-a-dinner', path: 'join-a-dinner/', label: 'Join a dinner' },
  { slug: 'join-the-team', path: 'join-the-team/', label: 'Join the team' },
  { slug: 'event', path: 'event/', label: 'Event' },
  { slug: 'about', path: 'about/', label: 'About' },
];
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Cook & Connect home">
    <img src={`${base}assets/logo.jpeg`} alt="" />
  </a>
  <details class="mobile-menu">
    <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
    <nav class="site-nav" aria-label="Main navigation">
      {navigation.map((item) => (
        <a href={`${base}${item.path}`} aria-current={currentPage === item.slug ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </details>
  <nav class="site-nav desktop-nav" aria-label="Main navigation">
    {navigation.map((item) => (
      <a href={`${base}${item.path}`} aria-current={currentPage === item.slug ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>
