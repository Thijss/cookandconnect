---
import { PortableText } from '@portabletext/astro';
import PortableLink from '../components/PortableLink.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getPage } from '../lib/sanity';

const page = await getPage('home');
---

<SiteLayout title={page.title} description={page.description} currentPage="home">
  <main>
    <section class="hero" aria-labelledby="page-title">
      <div class="hero-content">
        <h1 id="page-title">{page.title}</h1>
        {page.tagline && <p>{page.tagline}</p>}
      </div>
    </section>
    <section class="intro">
      <PortableText value={page.body} components={{ mark: { link: PortableLink } }} />
    </section>
  </main>
</SiteLayout>
