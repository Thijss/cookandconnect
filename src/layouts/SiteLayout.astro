---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getNavigationPages } from '../lib/sanity';

interface Props {
  title: string;
  description: string;
  currentPage: string;
}

const { title, description, currentPage } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigationPages = await getNavigationPages();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffc766" />
    <title>{title}</title>
    <link rel="icon" href={`${base}assets/logo.jpeg`} type="image/jpeg" />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <SiteHeader currentPage={currentPage} navigationPages={navigationPages} />
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/animations.js';
    </script>
  </body>
</html>
